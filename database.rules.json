{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "referralBalance": {
          ".validate": "!newData.exists() || (newData.isNumber() && (newData.val() === data.val() || (!data.exists() && newData.val() === 0)))"
        },
        "referralCount": {
          ".validate": "!newData.exists() || (newData.isNumber() && (newData.val() === data.val() || (!data.exists() && newData.val() === 0)))"
        },
        "referredBy": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val() !== $uid && root.child('users').child(newData.val()).exists() && (!data.exists() || data.val() === newData.val() || root.child('adminUsers').child(auth.uid).exists()))"
        },
        "referredAt": {
          ".validate": "!newData.exists() || (newData.isNumber() && (!data.exists() || data.val() === newData.val() || root.child('adminUsers').child(auth.uid).exists()))"
        }
      }
    },
    "referralCodes": {
      ".read": true,
      "$code": {
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      }
    },
    "adminUsers": {
      ".read": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('adminUsers').child(auth.uid).child('roles').child('0').val() === 'super_admin' || root.child('adminUsers').child(auth.uid).child('roles').child('1').val() === 'super_admin' || root.child('adminUsers').child(auth.uid).child('roles').child('2').val() === 'super_admin' || root.child('adminUsers').child(auth.uid).child('role').val() === 'super_admin')"
      }
    },
    "drivers": {
      ".read": "auth != null",
      ".indexOn": [
        "enterpriseId"
      ],
      "$driverId": {
        ".write": "auth != null && (auth.uid === $driverId || root.child('adminUsers').child(auth.uid).exists() || data.child('enterpriseId').val() === auth.uid)",
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "status": {
          ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected'"
        },
        "online": {
          ".validate": "newData.isBoolean()"
        },
        "pendingCommission": {
          ".validate": "root.child('adminUsers').child(auth.uid).exists() || !data.exists() || newData.val() >= data.val()"
        },
        "earningsBalance": {
          ".validate": "!data.exists() || newData.val() >= data.val() || root.child('adminUsers').child(auth.uid).exists()"
        }
      }
    },
    "driverPublic": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('adminUsers').child(auth.uid).exists())",
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "heading": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "available": {
          ".validate": "newData.isBoolean()"
        },
        "online": {
          ".validate": "newData.isBoolean() && (newData.val() !== true || root.child('drivers').child($uid).child('approved').val() === true)"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "vehicle": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "deliveryRequests": {
      ".read": "auth != null && (root.child('adminUsers').child(auth.uid).exists() || (query.orderByChild == 'status' && query.equalTo == 'pending') || (query.orderByChild == 'assignedDriverId' && query.equalTo == auth.uid) || (query.orderByChild == 'assignedDriverId' && root.child('drivers').child(query.equalTo).child('enterpriseId').val() == auth.uid) || (query.orderByChild == 'clientUid' && query.equalTo == auth.uid))",
      ".indexOn": [
        "assignedDriverId",
        "status",
        "clientUid"
      ],
      "$requestId": {
        ".read": "auth != null && (data.child('status').val() === 'pending' || data.child('clientUid').val() === auth.uid || data.child('assignedDriverId').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('clientUid').val() === auth.uid) || (data.exists() && data.child('clientUid').val() === auth.uid) || (data.exists() && data.child('assignedDriverId').val() === auth.uid) || (data.exists() && !data.child('assignedDriverId').exists() && newData.child('assignedDriverId').val() === auth.uid) || root.child('adminUsers').child(auth.uid).exists())",
        "clientUid": {
          ".validate": "!data.exists() || newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "assignedDriverId": {
          ".validate": "newData.val() === data.val() || (newData.val() === auth.uid && root.child('drivers').child(auth.uid).exists()) || root.child('adminUsers').child(auth.uid).exists()"
        },
        "price": {
          ".validate": "!data.exists() || newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "distanceKm": {
          ".validate": "!data.exists() || newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "paymentMethod": {
          ".validate": "!data.exists() || newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "paymentStatus": {
          ".validate": "newData.val() === data.val() || newData.val() !== 'paid' || newData.parent().child('paymentMethod').val() === 'cash' || root.child('adminUsers').child(auth.uid).exists()"
        },
        "status": {
          ".validate": "((data.exists() || newData.parent().child('paymentMethod').val() !== 'online' || newData.val() === 'awaiting_payment' || root.child('adminUsers').child(auth.uid).exists()) && (data.val() !== 'awaiting_payment' || newData.val() === 'awaiting_payment' || root.child('adminUsers').child(auth.uid).exists())) && (data.parent().child('handover').val() !== true || newData.val() !== 'completed' || data.val() === 'completed' || root.child('adminUsers').child(auth.uid).exists())"
        },
        "ticket": {
          ".validate": "(!newData.exists() || (newData.isString() && newData.val().matches(/^LIV-[0-9]{6}-[A-HJ-NP-Z2-9]{6}$/))) && (!data.exists() || newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists())"
        },
        "handover": {
          ".validate": "newData.isBoolean() && (data.exists() ? newData.val() === data.val() : newData.val() === true) || root.child('adminUsers').child(auth.uid).exists()"
        },
        "pickedUpAt": {
          ".validate": "newData.val() === data.val() || data.parent().child('handover').val() !== true || root.child('adminUsers').child(auth.uid).exists()"
        },
        "completedAt": {
          ".validate": "newData.val() === data.val() || data.parent().child('handover').val() !== true || root.child('adminUsers').child(auth.uid).exists()"
        }
      }
    },
    "marketplaceOrders": {
      ".read": "auth != null && (root.child('adminUsers').child(auth.uid).exists() || (query.orderByChild == 'status' && query.equalTo == 'pending_delivery') || (query.orderByChild == 'shopId' && query.equalTo == auth.uid) || (query.orderByChild == 'clientUid' && query.equalTo == auth.uid) || (query.orderByChild == 'assignedDriverId' && query.equalTo == auth.uid) || (query.orderByChild == 'assignedDriverId' && root.child('drivers').child(query.equalTo).child('enterpriseId').val() == auth.uid))",
      ".indexOn": [
        "assignedDriverId",
        "status",
        "clientUid",
        "shopId"
      ],
      "$orderId": {
        ".read": "auth != null && (data.child('status').val() === 'pending_delivery' || data.child('clientUid').val() === auth.uid || data.child('assignedDriverId').val() === auth.uid || data.child('shopId').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('clientUid').val() === auth.uid) || (data.exists() && data.child('clientUid').val() === auth.uid) || (data.exists() && data.child('shopId').val() === auth.uid) || (data.exists() && data.child('assignedDriverId').val() === auth.uid) || (data.exists() && !data.child('assignedDriverId').exists() && newData.child('assignedDriverId').val() === auth.uid) || root.child('adminUsers').child(auth.uid).exists())",
        "subtotal": {
          ".validate": "!data.exists() || newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "deliveryFee": {
          ".validate": "!data.exists() || newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "total": {
          ".validate": "!data.exists() || newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "shopId": {
          ".validate": "!data.exists() || newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "paymentMethod": {
          ".validate": "!data.exists() || newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "paymentStatus": {
          ".validate": "newData.val() === data.val() || newData.val() !== 'paid' || newData.parent().child('paymentMethod').val() === 'cash' || root.child('adminUsers').child(auth.uid).exists()"
        },
        "status": {
          ".validate": "((data.exists() || newData.parent().child('paymentMethod').val() !== 'online' || newData.val() === 'awaiting_payment' || root.child('adminUsers').child(auth.uid).exists()) && (data.val() !== 'awaiting_payment' || newData.val() === 'awaiting_payment' || newData.val() === 'cancelled' || root.child('adminUsers').child(auth.uid).exists()) && (newData.val() !== 'cancelled' || newData.parent().child('paymentMethod').val() !== 'online' || newData.parent().child('paymentStatus').val() !== 'paid' || root.child('adminUsers').child(auth.uid).exists())) && (!data.exists() || data.parent().child('handover').val() !== true || ((newData.val() !== 'delivered' && newData.val() !== 'awaiting_payment') || data.val() === newData.val() || root.child('adminUsers').child(auth.uid).exists()) && (newData.val() !== 'completed' || data.val() === 'completed' || data.val() === 'delivered' || data.val() === 'awaiting_payment' || root.child('adminUsers').child(auth.uid).exists()))"
        },
        "clientUid": {
          ".validate": "!data.exists() || newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "assignedDriverId": {
          ".validate": "newData.val() === data.val() || (newData.val() === auth.uid && root.child('drivers').child(auth.uid).exists()) || root.child('adminUsers').child(auth.uid).exists()"
        },
        "ticket": {
          ".validate": "(!newData.exists() || (newData.isString() && newData.val().matches(/^CMD-[0-9]{6}-[A-HJ-NP-Z2-9]{6}$/))) && (!data.exists() || newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists())"
        },
        "handover": {
          ".validate": "newData.isBoolean() && (data.exists() ? newData.val() === data.val() : newData.val() === true) || root.child('adminUsers').child(auth.uid).exists()"
        },
        "pickedUpAt": {
          ".validate": "newData.val() === data.val() || data.parent().child('handover').val() !== true || root.child('adminUsers').child(auth.uid).exists()"
        },
        "deliveredAt": {
          ".validate": "newData.val() === data.val() || data.parent().child('handover').val() !== true || root.child('adminUsers').child(auth.uid).exists()"
        }
      }
    },
    "enterprises": {
      ".read": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
      "$entId": {
        ".read": "auth != null && auth.uid === $entId",
        ".write": "auth != null && (auth.uid === $entId || root.child('adminUsers').child(auth.uid).exists())"
      }
    },
    "shops": {
      ".read": "(auth != null && root.child('adminUsers').child(auth.uid).exists()) || (query.orderByChild == 'approved' && query.equalTo == true)",
      ".indexOn": [
        "approved"
      ],
      "$shopId": {
        ".read": "data.child('approved').val() === true || (auth != null && auth.uid === $shopId)",
        ".write": "auth != null && (auth.uid === $shopId || root.child('adminUsers').child(auth.uid).exists())",
        "referredBy": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val() !== $shopId && root.child('users').child(newData.val()).exists() && (!data.exists() || data.val() === newData.val() || data.parent().child('approved').val() !== true || root.child('adminUsers').child(auth.uid).exists()))"
        },
        "referredAt": {
          ".validate": "!newData.exists() || (newData.isNumber() && (!data.exists() || data.val() === newData.val() || data.parent().child('approved').val() !== true || root.child('adminUsers').child(auth.uid).exists()))"
        }
      }
    },
    "products": {
      ".read": true,
      ".indexOn": [
        "shopId"
      ],
      "$productId": {
        ".write": "auth != null && (newData.child('shopId').val() === auth.uid || data.child('shopId').val() === auth.uid || root.child('adminUsers').child(auth.uid).exists())"
      }
    },
    "registrations": {
      ".read": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
      "$regId": {
        ".read": "auth != null && auth.uid === $regId",
        ".write": "auth != null && (root.child('adminUsers').child(auth.uid).exists() || !data.exists())",
        ".validate": "newData.hasChildren(['type', 'status']) && (root.child('adminUsers').child(auth.uid).exists() || newData.child('status').val() === 'pending')"
      }
    },
    "supportTickets": {
      ".read": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
      "$ticketId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "messages": {
          "$msgId": {
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            }
          }
        }
      }
    },
    "notifications": {
      ".read": "auth != null",
      "$notifId": {
        ".write": "auth != null && root.child('adminUsers').child(auth.uid).exists()"
      }
    },
    "ads": {
      ".read": true,
      "$adId": {
        ".write": "auth != null && root.child('adminUsers').child(auth.uid).exists()"
      }
    },
    "locationRequests": {
      "$reqId": {
        ".read": "auth != null",
        ".write": "$reqId.matches(/^req_[a-z0-9]+$/) && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['lat', 'lng'])",
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        }
      }
    },
    "withdrawalRequests": {
      ".read": "auth != null && (root.child('adminUsers').child(auth.uid).exists() || (query.orderByChild == 'shopId' && query.equalTo == auth.uid) || (query.orderByChild == 'driverId' && query.equalTo == auth.uid))",
      ".indexOn": [
        "shopId",
        "driverId"
      ],
      "$id": {
        ".read": "auth != null && (data.child('shopId').val() === auth.uid || data.child('clientUid').val() === auth.uid || data.child('driverId').val() === auth.uid || root.child('adminUsers').child(auth.uid).exists())",
        ".write": "auth != null && (root.child('adminUsers').child(auth.uid).exists() || (!data.exists() && newData.child('status').val() === 'pending' && (newData.child('shopId').val() === auth.uid || newData.child('driverId').val() === auth.uid)))",
        ".validate": "!newData.exists() || root.child('adminUsers').child(auth.uid).exists() || (!newData.child('clientUid').exists() && !newData.child('debited').exists() && !newData.child('refunded').exists() && (!newData.child('kind').exists() || newData.child('kind').val() === 'driver'))"
      }
    },
    "commissionPayments": {
      ".read": "auth != null && (root.child('adminUsers').child(auth.uid).exists() || (query.orderByChild == 'driverId' && query.equalTo == auth.uid))",
      ".indexOn": [
        "driverId"
      ],
      "$id": {
        ".read": "auth != null && (data.child('driverId').val() === auth.uid || root.child('adminUsers').child(auth.uid).exists())",
        ".write": "auth != null && root.child('adminUsers').child(auth.uid).exists()"
      }
    },
    "platformStats": {
      ".read": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
      ".write": "auth != null"
    },
    "remittances": {
      ".read": "auth != null && (root.child('adminUsers').child(auth.uid).exists() || (query.orderByChild == 'driverId' && query.equalTo == auth.uid))",
      ".indexOn": [
        "driverId"
      ],
      "$id": {
        ".read": "auth != null && (data.child('driverId').val() === auth.uid || root.child('adminUsers').child(auth.uid).exists())",
        ".write": "auth != null && (root.child('adminUsers').child(auth.uid).exists() || (!data.exists() && newData.child('status').val() === 'owed') || (data.child('driverId').val() === auth.uid && newData.child('status').val() === 'declared'))"
      }
    },
    "payments": {
      ".read": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
      ".write": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
      "$txId": {
        ".read": "auth != null && data.child('clientUid').val() === auth.uid"
      }
    },
    "reels": {
      ".read": true,
      ".indexOn": [
        "shopId"
      ],
      "$reelId": {
        ".write": "auth != null && (root.child('adminUsers').child(auth.uid).exists() || (!root.child('bans').child(auth.uid).exists() && ((data.exists() && data.child('shopId').val() === auth.uid) || (!data.exists() && newData.child('shopId').val() === auth.uid && root.child('termsAcceptances').child(auth.uid).exists()))))",
        ".validate": "newData.hasChildren(['shopId', 'videoUrl', 'createdAt'])",
        "videoUrl": {
          ".validate": "newData.isString() && newData.val().length < 500"
        },
        "caption": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 300)"
        }
      }
    },
    "otps": {
      ".read": false,
      ".write": false
    },
    "mockSmsLog": {
      ".read": false,
      ".write": false
    },
    "reelStats": {
      ".read": true,
      "$reelId": {
        ".write": "auth != null",
        "viewCount": {
          ".validate": "!newData.exists() || (newData.isNumber() && (!data.exists() || newData.val() >= data.val()))"
        },
        "productClicks": {
          ".validate": "!newData.exists() || (newData.isNumber() && (!data.exists() || newData.val() >= data.val()))"
        },
        "commentCount": {
          ".validate": "!newData.exists() || (newData.isNumber() && (!data.exists() || newData.val() >= data.val()))"
        },
        "likeCount": {
          ".validate": "!newData.exists() || (newData.isNumber() && (!data.exists() || newData.val() >= data.val()))"
        },
        "watchMs": {
          ".validate": "!newData.exists() || (newData.isNumber() && (!data.exists() || newData.val() >= data.val()))"
        }
      }
    },
    "productStats": {
      ".read": true,
      "$productKey": {
        ".write": "auth != null",
        "viewCount": {
          ".validate": "!newData.exists() || (newData.isNumber() && (!data.exists() || newData.val() >= data.val()))"
        },
        "purchaseCount": {
          ".validate": "!newData.exists() || (newData.isNumber() && (!data.exists() || newData.val() >= data.val()))"
        }
      }
    },
    "reelComments": {
      ".read": true,
      "$reelId": {
        "$commentId": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && !root.child('bans').child(auth.uid).exists() && root.child('termsAcceptances').child(auth.uid).exists()) || root.child('adminUsers').child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['uid', 'name', 'text', 'createdAt'])",
          "uid": {
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300"
          },
          "createdAt": {
            ".validate": "newData.val() === now || root.child('adminUsers').child(auth.uid).exists()"
          }
        }
      }
    },
    "reelLikes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$reelId": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "userAffinity": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "referralCredits": {
      ".read": "auth != null && root.child('adminUsers').child(auth.uid).exists()"
    },
    "driverWallets": {
      ".read": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('adminUsers').child(auth.uid).exists())",
        "autoPay": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "commissionLedger": {
      ".read": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('adminUsers').child(auth.uid).exists())"
      }
    },
    "referrals": {
      ".read": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
      "$referrerUid": {
        ".read": "auth != null && (auth.uid === $referrerUid || root.child('adminUsers').child(auth.uid).exists())"
      }
    },
    "reports": {
      ".read": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
      ".indexOn": [
        "status"
      ],
      "$reportId": {
        ".write": "auth != null && (root.child('adminUsers').child(auth.uid).exists() || (!data.exists() && newData.child('reporterUid').val() === auth.uid && newData.child('status').val() === 'open' && !root.child('bans').child(auth.uid).exists()))",
        ".validate": "newData.hasChildren(['type', 'reason', 'reporterUid', 'createdAt', 'status'])",
        "type": {
          ".validate": "newData.val() === 'reel' || newData.val() === 'comment'"
        },
        "reason": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "details": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)"
        },
        "reporterUid": {
          ".validate": "newData.isString()"
        },
        "reelId": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)"
        },
        "commentId": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)"
        },
        "targetUid": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)"
        },
        "targetName": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)"
        },
        "excerpt": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)"
        },
        "status": {
          ".validate": "newData.val() === 'open' || newData.val() === 'actioned' || newData.val() === 'dismissed'"
        },
        "action": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)"
        },
        "resolvedBy": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "resolvedAt": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.val() === now || root.child('adminUsers').child(auth.uid).exists()"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$blockedUid": {
          ".validate": "!newData.exists() || ($blockedUid !== auth.uid && newData.hasChildren(['name', 'at']) && newData.child('name').isString() && newData.child('name').val().length <= 80)"
        }
      }
    },
    "bans": {
      ".read": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('adminUsers').child(auth.uid).exists())",
        ".write": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['at', 'reason'])"
      }
    },
    "termsAcceptances": {
      ".read": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['version', 'acceptedAt']) && newData.child('version').isString() && newData.child('version').val().length <= 20",
        "acceptedAt": {
          ".validate": "newData.val() === now"
        }
      }
    },
    "presence": {
      ".read": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
      "$role": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && ($role === 'client' || $role === 'vendor' || $role === 'driver' || $role === 'entreprise')",
          ".validate": "!newData.exists() || newData.hasChildren(['at'])",
          "at": {
            ".validate": "newData.val() === now"
          }
        }
      }
    },
    "tickets": {
      ".read": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
      "$ticket": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || root.child('adminUsers').child(auth.uid).exists())",
        ".validate": "$ticket.matches(/^(LIV|CMD)-[0-9]{6}-[A-HJ-NP-Z2-9]{6}$/) && newData.hasChildren(['kind','id','uid']) && newData.child('kind').isString() && newData.child('id').isString() && newData.child('id').val().length < 60 && newData.child('uid').isString()",
        "$other": {
          ".validate": "false"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "kind": {
          ".validate": "newData.val() === 'delivery' || newData.val() === 'order'"
        },
        "id": {
          ".validate": "newData.isString()"
        },
        "uid": {
          ".validate": "newData.isString()"
        }
      }
    },
    "places": {
      ".read": true,
      ".indexOn": [
        "k"
      ],
      "$id": {
        ".write": "auth != null && root.child('adminUsers').child(auth.uid).exists()",
        ".validate": "!newData.exists() || (newData.hasChildren(['n','k','lat','lng']) && newData.child('n').isString() && newData.child('n').val().length > 0 && newData.child('n').val().length <= 80 && newData.child('k').isString() && newData.child('k').val().length <= 80 && newData.child('lat').isNumber() && newData.child('lat').val() >= 9 && newData.child('lat').val() <= 15.5 && newData.child('lng').isNumber() && newData.child('lng').val() >= -5.7 && newData.child('lng').val() <= 2.5)",
        "n": {
          ".validate": "newData.isString()"
        },
        "k": {
          ".validate": "newData.isString()"
        },
        "lat": {
          ".validate": "newData.isNumber()"
        },
        "lng": {
          ".validate": "newData.isNumber()"
        },
        "t": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "s": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "o": {
          ".validate": "newData.isNumber()"
        },
        "fixed": {
          ".validate": "newData.isBoolean()"
        },
        "at": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "deliveryCodes": {
      ".read": "root.child('adminUsers').child(auth.uid).exists()",
      ".write": "root.child('adminUsers').child(auth.uid).exists()"
    },
    "sponsoredReels": {
      ".read": "auth != null && (root.child('adminUsers').child(auth.uid).exists() || (query.orderByChild == 'status' && query.equalTo == 'active') || (query.orderByChild == 'ownerUid' && query.equalTo == auth.uid))",
      ".indexOn": [
        "status",
        "ownerUid"
      ],
      "$sid": {
        ".read": "auth != null && (data.child('status').val() === 'active' || data.child('ownerUid').val() === auth.uid || root.child('adminUsers').child(auth.uid).exists())",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && data.child('ownerUid').val() === auth.uid && (newData.exists() || data.child('status').val() === 'awaiting_payment')) || root.child('adminUsers').child(auth.uid).exists())",
        "ownerUid": {
          ".validate": "!data.exists() || newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "ownerRole": {
          ".validate": "newData.isString() && (newData.val() === 'client' || newData.val() === 'shop' || newData.val() === 'driver' || newData.val() === 'enterprise') && (!data.exists() || newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists())"
        },
        "ownerName": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "ownerPhone": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "videoUrl": {
          ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/.{3,600}$/) && (!data.exists() || newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists())"
        },
        "linkUrl": {
          ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/.{3,500}$/)"
        },
        "caption": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "cities": {
          ".validate": "newData.hasChildren()",
          "$i": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          }
        },
        "createdAt": {
          ".validate": "!data.exists() || newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "status": {
          ".validate": "(!data.exists() ? newData.val() === 'awaiting_payment' : newData.val() === data.val()) || root.child('adminUsers').child(auth.uid).exists()"
        },
        "paymentStatus": {
          ".validate": "newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "paymentTxId": {
          ".validate": "newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "paymentTxAt": {
          ".validate": "newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "paidAt": {
          ".validate": "newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "startsAt": {
          ".validate": "newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "endsAt": {
          ".validate": "newData.val() === data.val() || root.child('adminUsers').child(auth.uid).exists()"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "sponsorStats": {
      "$sid": {
        ".read": "auth != null && (root.child('adminUsers').child(auth.uid).exists() || root.child('sponsoredReels').child($sid).child('ownerUid').val() === auth.uid)",
        "$day": {
          ".validate": "$day.matches(/^[0-9]{8}$/)",
          ".write": "auth != null && (root.child('sponsoredReels').child($sid).child('status').val() === 'active' || root.child('adminUsers').child(auth.uid).exists())",
          "views": {
            ".validate": "newData.isNumber() && (newData.val() === (data.exists() ? data.val() : 0) + 1 || root.child('adminUsers').child(auth.uid).exists())"
          },
          "clicks": {
            ".validate": "newData.isNumber() && (newData.val() === (data.exists() ? data.val() : 0) + 1 || root.child('adminUsers').child(auth.uid).exists())"
          },
          "$other": {
            ".validate": "false"
          }
        }
      }
    },
    "driverPayoutAccounts": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('adminUsers').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('adminUsers').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['network','phone','holderName'])",
        "network": {
          ".validate": "newData.isString() && (newData.val() === 'orange_bf_direct' || newData.val() === 'moov_bf')"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{8}$/)"
        },
        "holderName": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": "false"
        }
      }
    }
  }
}
